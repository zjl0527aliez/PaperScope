# PaperScope only reads these values on the backend. Never put API keys in web/app.js.
PAPERSCOPE_LLM_PROVIDER=deepseek
PAPERSCOPE_LLM_API_KEY=
PAPERSCOPE_LLM_BASE_URL=https://api.deepseek.com
PAPERSCOPE_LLM_MODEL=deepseek-flash

# Optional: one free OpenAlex key is shared by search and citation expansion.
PAPERSCOPE_OPENALEX_API_KEY=

# Advanced per-capability overrides. By default both use keyless OpenAlex.
PAPERSCOPE_PAPER_SEARCH_PROVIDER=openalex-free
PAPERSCOPE_PAPER_SEARCH_API_KEY=

PAPERSCOPE_CITATION_PROVIDER=openalex-free
PAPERSCOPE_CITATION_API_KEY=

